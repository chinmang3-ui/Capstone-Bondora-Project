            <format attr='border-width' value='1' />
          </zone-style>
        </zone>
        <zone h='9840' id='190' type-v2='text' w='28889' x='68148' y='60886'>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#1f6f8b' fontsize='26'>0.65</run>
            <run fontalignment='1'>Æ&#10;</run>
            <run fontalignment='1' fontcolor='#5b6b7b' fontsize='11'>AUC (default model: 0.70)</run>
          </formatted-text>
          <zone-style>
            <format attr='border-color' value='#d5dde5' />
            <format attr='border-style' value='solid' />
            <format attr='border-width' value='1' />
            <_.fcp.DashboardRoundedCorners.true...format attr='corner-radius' value='8' />
            <format attr='padding' value='12' />
            <format attr='background-color' value='#f4f7f9' />
          </zone-style>
        </zone>
        <zone forceUpdate='true' h='9840' id='191' type-v2='text' w='28889' x='68148' y='71956'>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#c0392b' fontsize='24'>5.4×</run>
            <run fontalignment='1'>Æ&#10;</run>
            <run fontalignment='1' fontcolor='#5b6b7b' fontsize='11'>riskiest vs safest 10% </run>
            <run fontalignment='1' fontcolor='#000000'>Æ       </run>
            <run fontalignment='1'>Æ&#10;</run>
          </formatted-text>
          <zone-style>
            <format attr='border-color' value='#d5dde5' />
            <format attr='border-style' value='solid' />
            <format attr='border-width' value='1' />
            <_.fcp.DashboardRoundedCorners.true...format attr='corner-radius' value='8' />
            <format attr='padding' value='12' />
            <format attr='background-color' value='#f4f7f9' />
          </zone-style>
        </zone>
        <zone forceUpdate='true' h='9840' id='192' type-v2='text' w='28889' x='68148' y='83026'>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#c0392b' fontsize='22'>3.5×</run>
            <run fontalignment='1'>Æ&#10;</run>
            <run fontalignment='1' fontcolor='#5b6b7b' fontsize='11'>Estonia vs Denmark    </run>
            <run fontalignment='1' fontcolor='#000000'>Æ    </run>
          </formatted-text>
          <zone-style>
            <format attr='border-color' value='#d5dde5' />
            <format attr='border-style' value='solid' />
            <format attr='border-width' value='1' />
            <_.fcp.DashboardRoundedCorners.true...format attr='corner-radius' value='8' />
            <format attr='background-color' value='#f4f7f9' />
          </zone-style>
        </zone>
        <zone h='31980' id='193' type-v2='text' w='63704' x='2963' y='60886'>
          <formatted-text>
            <run bold='true' fontcolor='#1f6f8b' fontsize='16'>Key findings</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>• </run>
            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>Weaker than default (AUC 0.65 vs 0.70),</run>
            <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'> but useful: the riskiest 10% cancel 10.3%, the safest 10% only 1.9% (5.4×). Average 4.1%.</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>• </run>
            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>Country is the main driver,</run>
            <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'> the opposite of default: Estonia (3.5×), Latvia (3.2×) and Finland (2.7×) cancel much more often than Denmark.</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>• </run>
            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>Larger and longer loans</run>
            <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'> are cancelled less (0.72× and 0.77×). </run>
            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>Rating</run>
            <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'> hardly matters (0.85×–1.25×).</run>
            <run>Æ&#10;</run>
            <run fontcolor='#5b6b7b' fontname='Benton Sans Book' fontsize='10' italic='true'>Answer: partly. The model ranks loans, but cancellations are harder to predict than defaults.</run>
          </formatted-text>
          <zone-style>
            <format attr='border-color' value='#d5dde5' />
            <format attr='border-style' value='solid' />
            <format attr='border-width' value='1' />
            <_.fcp.DashboardRoundedCorners.true...format attr='corner-radius' value='8' />
            <format attr='padding' value='12' />
            <format attr='background-color' value='#f3f5f8' />
          </zone-style>
        </zone>
      </zones>
