      <devicelayouts>
        <devicelayout auto-generated='true' name='Phone'>
          <size maxheight='700' minheight='700' sizing-mode='vscroll' />
          <zones>
            <zone h='100000' id='318' type-v2='layout-basic' w='100000' x='0' y='0'>
              <zone h='84000' id='317' param='vert' type-v2='layout-flow' w='84000' x='8000' y='8000'>
                <zone forceUpdate='true' h='6150' id='3' type-v2='text' w='94074' x='2963' y='1845'>
                  <formatted-text>
                    <run bold='true' fontcolor='#1f6f8b' fontsize='24'>Limitations: what should you keep in mind?</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#444444' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
                <zone forceUpdate='true' h='59041' id='161' type-v2='text' w='30370' x='2963' y='11685'>
                  <formatted-text>
                    <run bold='true' fontcolor='#1f6f8b' fontsize='18'>1 Data</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#5b6b7b' fontsize='11' italic='true'>What the data cannot show yet</run>
                    <run>Æ&#10;&#10;</run>
                    <run fontcolor='#000000' fontsize='11'>•</run>
                    <run fontcolor='#000000' fontsize='14'>Æ </run>
                    <run bold='true' fontcolor='#000000' fontsize='14'>Many 2025 loans are still young</run>
                    <run bold='true' fontcolor='#000000' fontsize='11'>.</run>
                    <run fontcolor='#000000' fontsize='11'> 25,466 loans have no 12-month outcome yet, so their final default rate is unknown.</run>
                    <run>Æ&#10;&#10;</run>
                    <run fontcolor='#000000' fontsize='14'>• </run>
                    <run bold='true' fontcolor='#000000' fontsize='14'>Small countries.</run>
                    <run fontcolor='#000000' fontsize='11'> Spain, Latvia and Denmark have few loans, so their rates are less stable.</run>
                    <run>Æ&#10;&#10;</run>
                    <run fontcolor='#000000' fontsize='14'>• </run>
                    <run bold='true' fontcolor='#000000' fontsize='14'>HR not interpreted</run>
                    <run bold='true' fontcolor='#000000' fontsize='11'>.</run>
                    <run fontcolor='#000000' fontsize='11'> Only 19 loans.</run>
                    <run>Æ&#10;&#10;&#10;&#10;&#10;&#10;&#10;&#10;&#10;&#10;&#10;&#10;&#10;</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#d5dde5' />
                    <format attr='border-style' value='solid' />
                    <format attr='border-width' value='1' />
                    <_.fcp.DashboardRoundedCorners.true...format attr='corner-radius' value='8' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                    <format attr='background-color' value='#f4f7f9' />
                  </zone-style>
                </zone>
                <zone forceUpdate='true' h='59041' id='162' type-v2='text' w='30370' x='34815' y='11685'>
                  <formatted-text>
                    <run bold='true' fontcolor='#1f6f8b' fontsize='18'>2 Method</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#5b6b7b' fontsize='11' italic='true'>How to read the results</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontsize='14'>• </run>
                    <run bold='true' fontcolor='#000000' fontsize='14'>Association, not cause</run>
                    <run bold='true' fontcolor='#000000' fontsize='18'>.</run>
                    <run fontcolor='#000000' fontsize='18'>Æ </run>
                    <run fontcolor='#000000' fontsize='12'>A risk driver shows who defaults more, not why.</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontsize='14'>• </run>
                    <run bold='true' fontcolor='#000000' fontsize='14'>Leakage removed</run>
                    <run bold='true' fontcolor='#000000' fontsize='18'>.</run>
                    <run fontcolor='#000000' fontsize='18'>Æ </run>
                    <run fontcolor='#000000' fontsize='12'>principal_debt, months_in_default and loan_status are only known after default, so they were left out of the model.</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontsize='14'>• </run>
                    <run bold='true' fontcolor='#000000' fontsize='14'>Many false alarms</run>
                    <run bold='true' fontcolor='#000000' fontsize='18'>.</run>
                    <run fontcolor='#000000' fontsize='18'>Æ </run>
                    <run fontcolor='#000000' fontsize='12'>At cut-off 0.5, only 14.9% of flagged loans actually default.</run>
                    <run>Æ&#10;&#10;&#10;&#10;&#10;</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#d5dde5' />
                    <format attr='border-style' value='solid' />
                    <format attr='border-width' value='1' />
                    <_.fcp.DashboardRoundedCorners.true...format attr='corner-radius' value='8' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                    <format attr='background-color' value='#f3f5f8' />
                  </zone-style>
                </zone>
                <zone forceUpdate='true' h='59041' id='163' type-v2='text' w='30370' x='66667' y='11685'>
