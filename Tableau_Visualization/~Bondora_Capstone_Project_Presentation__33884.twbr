          <formatted-text>
            <run bold='true' fontcolor='#1f6f8b' fontsize='22'>Q8. Which combinations of rating, duration and country are the riskiest?</run>
          </formatted-text>
        </zone>
        <zone forceUpdate='true' h='3690' id='14' type-v2='text' w='22222' x='51037' y='68143'>
