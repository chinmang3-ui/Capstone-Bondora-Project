        </zone>
        <zone forceUpdate='true' h='15375' id='26' type-v2='text' w='28889' x='68148' y='9225'>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#c0392b' fontsize='26'>24.5%</run>
            <run fontalignment='1'>Æ&#10;</run>
            <run fontalignment='1' fontsize='11'>default rate in the riskiest 10% (group 1)</run>
          </formatted-text>
          <zone-style>
            <format attr='border-color' value='#d5dde5' />
            <format attr='border-style' value='solid' />
            <format attr='border-width' value='1' />
            <format attr='background-color' value='#f4f7f9' />
          </zone-style>
        </zone>
        <zone h='15375' id='27' type-v2='text' w='28889' x='68148' y='26076'>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#1f6f8b' fontsize='26'>1.7%</run>
            <run fontalignment='1'>Æ&#10;</run>
            <run fontalignment='1' fontsize='11'>default rate in the safest 10% (group 10)</run>
          </formatted-text>
          <zone-style>
            <format attr='border-color' value='#d5dde5' />
            <format attr='border-style' value='solid' />
            <format attr='border-width' value='1' />
            <format attr='background-color' value='#f4f7f9' />
          </zone-style>
        </zone>
        <zone forceUpdate='true' h='15375' id='28' type-v2='text' w='28889' x='68148' y='43050'>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#1f6f8b' fontsize='26'>14×</run>
            <run fontalignment='1'>Æ&#10;</run>
            <run fontalignment='1' fontsize='11'>more defaults in the riskiest vs the safest group</run>
          </formatted-text>
          <zone-style>
            <format attr='border-color' value='#d5dde5' />
            <format attr='border-style' value='solid' />
            <format attr='border-width' value='1' />
            <format attr='background-color' value='#f4f7f9' />
          </zone-style>
        </zone>
        <zone forceUpdate='true' h='31980' id='29' type-v2='text' w='63704' x='2963' y='60886'>
          <formatted-text>
            <run bold='true' fontcolor='#1f6f8b' fontsize='16'>Key findings </run>
            <run>Æ&#10;</run>
            <run fontcolor='#333333' fontsize='11'>• Default falls steadily from group 1 (</run>
            <run bold='true' fontcolor='#000000' fontsize='11'>24.5%</run>
            <run fontcolor='#333333' fontsize='11'>) to group 10 (</run>
            <run bold='true' fontcolor='#000000' fontsize='11'>1.7%</run>
            <run fontcolor='#333333' fontsize='11'>), so the model ranks loans in the right order</run>
            <run>Æ&#10;</run>
            <run fontcolor='#333333' fontsize='11'>• The riskiest 10% default </run>
            <run bold='true' fontcolor='#333333' fontsize='11'>14× more</run>
            <run fontcolor='#333333' fontsize='11'> than the safest 10% and about</run>
            <run bold='true' fontcolor='#333333' fontsize='11'> 2.7×</run>
            <run fontcolor='#333333' fontsize='11'> the average (9.1%)</run>
            <run>Æ&#10;</run>
            <run fontcolor='#333333' fontsize='11'>• Checking the </run>
            <run bold='true' fontcolor='#333333' fontsize='11'>riskiest 10–20%</run>
            <run fontcolor='#333333' fontsize='11'> of new loans by hand focuses the review where the risk is highest</run>
            <run>Æ&#10;</run>
            <run fontcolor='#333333' fontsize='11'>Based on </run>
            <run bold='true' fontcolor='#333333' fontsize='11'>77,080</run>
            <run fontcolor='#333333' fontsize='11'> test loans the model had never seen</run>
          </formatted-text>
          <zone-style>
            <format attr='border-color' value='#d5dde5' />
            <format attr='border-style' value='solid' />
            <format attr='border-width' value='1' />
            <format attr='background-color' value='#f4f7f9' />
          </zone-style>
        </zone>
      </zones>
