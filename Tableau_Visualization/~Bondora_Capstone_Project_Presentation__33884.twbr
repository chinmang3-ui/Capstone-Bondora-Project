        <zone h='6765' id='24' mode='checkdropdown' name='Risk groups: default' param='[federated.0ovuu471h1x9wm0znxm2s06brm5j].[none:country:nk]' type-v2='filter' w='28889' x='68148' y='65191' />
        <zone h='3690' id='25' type-v2='text' w='28889' x='68148' y='60886'>
          <formatted-text>
            <run bold='true' fontcolor='#1f6f8b' fontsize='14'>Filter the charts</run>
